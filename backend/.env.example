# Postgres connection string — provisioned by the platform in every deployed environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_development"

# HS256 signing secret for API tokens — provisioned by the platform.
JWT_SECRET="change-me-in-local-development-only"

# Optional: token lifetime (default 7d) and listen ports.
JWT_EXPIRES_IN="7d"
PORT=3000
ALT_PORT=3001
